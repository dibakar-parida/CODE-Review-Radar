{
  "name": "@cr/vscode-ext",
  "displayName": "cr — Local-First AI Code Review",
  "version": "0.1.0",
  "publisher": "cr-team",
  "engines": {
    "vscode": "^1.80.0"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cr.reviewCurrentFile",
        "title": "cr: Review Current File"
      },
      {
        "command": "cr.reviewStaged",
        "title": "cr: Review Staged Changes"
      },
      {
        "command": "cr.applyFix",
        "title": "cr: Apply Verified Fix"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cr/core": "workspace:*",
    "@cr/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
